{
  "__inputs": [
    {
      "name": "DS_SPENDANTT",
      "label": "SpendAntt Analytics",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" }
  ],
  "uid": "spendantt-analytics",
  "title": "SpendAntt – Analytics",
  "tags": ["spendantt"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "BQ1 · Crashes por módulo",
      "description": "Número de crashes registrados por módulo en el rango de tiempo seleccionado.",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
          "rawSql": "SELECT module_name, COUNT(*) AS crashes FROM crashes WHERE $__timeFilter(created_at) GROUP BY module_name ORDER BY crashes DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "xField": "module_name",
        "orientation": "auto",
        "barWidth": 0.7,
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "title": "BQ2 · Usuarios inactivos (≥3 días sin gasto)",
      "description": "Usuarios que no han registrado un gasto en 3 o más días.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
          "rawSql": "SELECT SUM(CASE WHEN is_inactive THEN 1 ELSE 0 END) AS value FROM days_since_expense",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "BQ2 · Promedio días sin gasto",
      "description": "Promedio de días transcurridos desde el último gasto entre todos los usuarios.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
          "rawSql": "SELECT ROUND(AVG(days)::numeric, 1) AS value FROM days_since_expense",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 7 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "BQ2 · Activos vs Inactivos",
      "description": "Distribución actual de usuarios activos e inactivos.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 10, "x": 14, "y": 4 },
      "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
          "rawSql": "SELECT SUM(CASE WHEN NOT is_inactive THEN 1 ELSE 0 END) AS \"Activos\", SUM(CASE WHEN is_inactive THEN 1 ELSE 0 END) AS \"Inactivos\" FROM days_since_expense",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Activos" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Inactivos" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "BQ3 · OCR Edit Rate promedio",
      "description": "Proporción de campos rellenados por OCR que luego edita el usuario. Alto = OCR poco preciso.",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
          "rawSql": "SELECT COALESCE(ROUND(AVG(edit_rate)::numeric, 2), 0) AS value FROM ocr_edit_rate WHERE $__timeFilter(created_at)",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 6,
      "title": "BQ4 · Sesiones por franja horaria",
      "description": "Distribución de aperturas de la app según la franja horaria (morning / afternoon / evening / night).",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
      "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
          "rawSql": "SELECT session, COUNT(*) AS logins FROM active_hours WHERE $__timeFilter(created_at) GROUP BY session ORDER BY logins DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "xField": "session",
        "orientation": "auto",
        "barWidth": 0.7,
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 7,
      "title": "BQ5 · Gastos pequeños recurrentes",
      "description": "Total de gastos recurrentes < $50.000 en los últimos 3 meses, por todos los usuarios.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
          "rawSql": "SELECT COALESCE(SUM(count), 0) AS \"# Gastos\", COALESCE(ROUND(SUM(total_amount)::numeric, 0), 0) AS \"Monto total (COP)\" FROM small_recurring_expenses",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "title": "BQ6 · Métodos de registro de gastos",
      "description": "Cuántos gastos se han registrado por cada método: Manual, OCR (foto de recibo) o Google Pay.",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_SPENDANTT}" },
          "rawSql": "SELECT 'Manual' AS method, COALESCE(SUM(manual_count), 0) AS total FROM registration_methods UNION ALL SELECT 'OCR', COALESCE(SUM(ocr_count), 0) FROM registration_methods UNION ALL SELECT 'Google Pay', COALESCE(SUM(google_pay_count), 0) FROM registration_methods ORDER BY total DESC",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "xField": "method",
        "orientation": "auto",
        "barWidth": 0.7,
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ]
}
